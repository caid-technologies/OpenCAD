{
  "$id": "https://caid-technologies.com/schemas/caid-design-artifact-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "feature_tree": {
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "object"
        },
        "root_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "root_id",
        "nodes"
      ],
      "type": "object"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/design_parameter"
      },
      "type": "object"
    },
    "producer": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "simulation_tags": {
      "items": {
        "$ref": "#/$defs/simulation_tag"
      },
      "type": "array"
    },
    "kinematic_joints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kinematic_joint"
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "producer",
    "created_at",
    "feature_tree",
    "parameters",
    "simulation_tags"
  ],
  "title": "CAID Design Artifact v1",
  "type": "object",
  "$defs": {
    "design_parameter": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "$ref": "#/$defs/parameter_value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "parameter_value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "simulation_tag": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "body",
            "joint",
            "geom",
            "site",
            "parameter"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "target"
      ],
      "type": "object"
    },
    "kinematic_joint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "fixed",
            "revolute",
            "prismatic"
          ]
        },
        "parent_shape_id": {
          "type": "string",
          "minLength": 1
        },
        "child_shape_id": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "origin_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "lower_limit": {
          "type": "number"
        },
        "upper_limit": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "none",
            "radian",
            "mm"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "parent_shape_id",
        "child_shape_id",
        "axis",
        "origin_mm",
        "lower_limit",
        "upper_limit",
        "unit"
      ]
    }
  }
}
