{
  "name": "opencad-viewport",
  "version": "0.2.0",
  "description": "React + Three.js viewport components for OpenCAD — 3D viewport, feature tree, sketch editor, and chat panel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caid-technologies/OpenCAD.git",
    "directory": "packages/opencad-viewport"
  },
  "homepage": "https://github.com/caid-technologies/OpenCAD/tree/main/packages/opencad-viewport#readme",
  "bugs": "https://github.com/caid-technologies/OpenCAD/issues",
  "keywords": ["cad", "opencad", "three", "react-three-fiber", "viewport", "3d", "parametric"],
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/opencad-viewport.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "axios": "^1.11.0"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
